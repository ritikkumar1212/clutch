{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CampusRadar: dev",
      "type": "shell",
      "command": "npm.cmd exec -- next dev -p 3001",
      "options": {
        "cwd": "${workspaceFolder}/campusradar/frontend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CampusRadar: web",
      "type": "shell",
      "command": "docker compose --env-file frontend/.env.local up --build",
      "options": {
        "cwd": "${workspaceFolder}/campusradar"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CampusRadar: stop",
      "type": "shell",
      "command": "docker compose --env-file frontend/.env.local down",
      "options": {
        "cwd": "${workspaceFolder}/campusradar"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
