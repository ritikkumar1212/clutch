{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CampusRadar: start",
      "detail": "Build once, then hot reload -> VS Code Simple Browser http://localhost:3000",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/start-campusradar.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "focus": false
      },
      "problemMatcher": []
    }
  ]
}
