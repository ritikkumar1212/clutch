{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CampusRadar: Start Docker",
      "type": "shell",
      "command": "docker compose --env-file frontend/.env.local up --build",
      "options": {
        "cwd": "${workspaceFolder}/campusradar"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CampusRadar: Stop Docker",
      "type": "shell",
      "command": "docker compose --env-file frontend/.env.local down",
      "options": {
        "cwd": "${workspaceFolder}/campusradar"
      },
      "problemMatcher": []
    },
    {
      "label": "CampusRadar: Frontend Dev (hot reload)",
      "type": "shell",
      "command": "npm.cmd exec -- next dev -p 3001",
      "options": {
        "cwd": "${workspaceFolder}/campusradar/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "CampusRadar: Open Dev Site",
      "type": "shell",
      "command": "Start-Process 'http://localhost:3001'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
